indexer = "prowlarr"

[general]
download_path = "~/downloads"
download_in_external_client = false
use_transmission = true
transmission_user = ""
transmission_pass = ""
theme = "textual-ansi"
timeout = 120
max_retries = 2
use_cache = true
cache_ttl = 300

[indexers]
default = "prowlarr"

[indexers.jackett]
url = "http://127.0.0.1:9117"
api_key = "@JACKETT_API_KEY@"

[indexers.prowlarr]
url = "http://127.0.0.1:9697"
api_key = "@PROWLARR_API_KEY@"
