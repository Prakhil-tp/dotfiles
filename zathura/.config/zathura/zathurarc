set statusbar-h-padding 0
set statusbar-v-padding 0
set page-padding 1
map d scroll half-down
map u scroll half-up
map D toggle_page_mode
map r reload
map R rotate
map K zoom in
map J zoom out
map i recolor
map p print

set adjust-open "best-fit"

# color scheme (solarized dark, matches kitty/nvim/rofi)
set notification-error-bg       "#002b36" # base03
set notification-error-fg       "#dc322f" # red
set notification-warning-bg     "#002b36" # base03
set notification-warning-fg     "#b58900" # yellow
set notification-bg             "#002b36" # base03
set notification-fg             "#859900" # green

set completion-bg               "#073642" # base02
set completion-fg               "#839496" # base0
set completion-group-bg         "#002b36" # base03
set completion-group-fg         "#586e75" # base01
set completion-highlight-bg     "#268bd2" # blue
set completion-highlight-fg     "#002b36" # base03

set index-bg                    "#073642" # base02
set index-fg                    "#839496" # base0
set index-active-bg             "#268bd2" # blue
set index-active-fg             "#002b36" # base03

set inputbar-bg                 "#002b36" # base03
set inputbar-fg                 "#839496" # base0

set statusbar-bg                "#073642" # base02
set statusbar-fg                "#839496" # base0

set highlight-color             "#b58900" # yellow  # highlight match when search keyword(vim's /)
set highlight-active-color      "#cb4b16" # orange

set default-bg                  "#002b36" # base03
set default-fg                  "#839496" # base0
set render-loading              true
set render-loading-bg           "#002b36" # base03
set render-loading-fg           "#839496" # base0

# Recolor book content's color (dark mode, toggle with `i`)
set recolor                     true
set recolor-lightcolor          "#002b36" # base03
set recolor-darkcolor           "#839496" # base0
set recolor-keephue             true      # keep original color
