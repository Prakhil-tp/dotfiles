#!/bin/sh

if [ -z "$(command -v vifm)" ]; then
	printf "vifm isn't installed on your system!\n"
	exit 1
fi

has_ueberzugpp=0
ueberzug_bin="ueberzug"
if command -v ueberzugpp >/dev/null 2>&1; then
	ueberzug_bin="ueberzugpp"
	has_ueberzugpp=1
elif ! command -v ueberzug >/dev/null 2>&1; then
	exec vifm "$@"
fi

CACHE_DIR="$HOME/.cache/vifm"
mkdir -p "$CACHE_DIR"
export FIFO_UEBERZUG="$CACHE_DIR/ueberzug-$$"

cleanup() {
	exec 3>&-
	rm -f "$FIFO_UEBERZUG"
}

mkfifo "$FIFO_UEBERZUG"
trap cleanup EXIT

if [ "$has_ueberzugpp" = 1 ]; then
	# ueberzugpp reads JSON from stdin by default (drop-in replacement)
	$ueberzug_bin layer --silent < "$FIFO_UEBERZUG" &
else
	$ueberzug_bin layer -p json < "$FIFO_UEBERZUG" &
fi

exec 3>"$FIFO_UEBERZUG"
vifm "$@"
~/.config/vifm/scripts/vifmimg clear
