#!/bin/sh

CACHE_DIR="$HOME/.cache/vifm"
mkdir -p "$CACHE_DIR"
FILE="$PWD/$6"
THUMB_KEY=$(printf '%s' "$FILE" | sha256sum | awk '{print $1}')
PCACHE="$CACHE_DIR/thumbnail.$THUMB_KEY"

[ -z "$FIFO_UEBERZUG" ] && exit 0

pclear() {
	printf '{"action": "remove", "identifier": "vifm-preview"}\n' > "$FIFO_UEBERZUG"
}

image() {
	printf '{"action": "add", "identifier": "vifm-preview", "x": %s, "y": %s, "width": %s, "height": %s, "scaler": "fit_contain", "path": "%s"}\n' "$2" "$3" "$4" "$5" "$6" > "$FIFO_UEBERZUG"
}

main() {
	case "$1" in
		"clear")
			pclear
			;;
		"draw")
			image "$1" "$2" "$3" "$4" "$5" "$FILE"
			;;
		"video")
			THUMB="${PCACHE}.jpg"
			[ ! -f "$THUMB" ] && \
				ffmpegthumbnailer -i "$FILE" -o "$THUMB" -s 256 -q 5 2>/dev/null
			[ -f "$THUMB" ] && image "$1" "$2" "$3" "$4" "$5" "$THUMB"
			;;
		"epub")
			[ ! -f "$PCACHE" ] && \
				epub-thumbnailer "$FILE" "$PCACHE" 1024 2>/dev/null
			[ -f "$PCACHE" ] && image "$1" "$2" "$3" "$4" "$5" "$PCACHE"
			;;
		"pdf")
			THUMB="${PCACHE}.jpg"
			[ ! -f "$THUMB" ] && \
				pdftoppm -jpeg -f 1 -singlefile "$FILE" "$THUMB" 2>/dev/null
			[ -f "$THUMB" ] && image "$1" "$2" "$3" "$4" "$5" "$THUMB"
			;;
		"djvu")
			THUMB="${PCACHE}.jpg"
			[ ! -f "$THUMB" ] && \
				ddjvu -format=tiff -quality=90 -page=1 "$FILE" "$THUMB" 2>/dev/null
			[ -f "$THUMB" ] && image "$1" "$2" "$3" "$4" "$5" "$THUMB"
			;;
		"audio")
			THUMB="${PCACHE}.jpg"
			[ ! -f "$THUMB" ] && \
				ffmpeg -hide_banner -i "$FILE" "$THUMB" -y >/dev/null 2>&1
			[ -f "$THUMB" ] && image "$1" "$2" "$3" "$4" "$5" "$THUMB"
			;;
		"font")
			THUMB="${PCACHE}.jpg"
			[ ! -f "$THUMB" ] && \
				fontpreview -i "$FILE" -o "$THUMB" 2>/dev/null
			[ -f "$THUMB" ] && image "$1" "$2" "$3" "$4" "$5" "$THUMB"
			;;
	esac
}
main "$@"
