/**
 * Dracula theme for rofi
 * Layout based on catppuccin-mocha, colors from dracula palette
 */

* {
    base:            #282a36;
    surface0:        #44475a;
    overlay0:        #6272a4;
    text:            #f8f8f2;
    lavender:        #bd93f9;
    red:             #ff5555;
    peach:           #ffb86c;
    green:           #50fa7b;
    blue:            #8be9fd;
    yellow:          #f1fa8c;
    mauve:           #bd93f9;
    teal:            #8be9fd;
    background-color: @base;
}

window {
    height: 700;
    width: 1500;
    children: [mainbox];
    orientation: horizontal;
    border: 0;
    border-radius: 10;
    border-color: @lavender;
}


mainbox {
    border:  0;
    padding: 0;
    spacing: 0;
    children: [inputbar, message, listview];
    border-color: @base;
    background-color: @base;
}

inputbar {
    color: @text;
    padding: 14;
    background-color: @base;
}

message {
    padding: 10px;
    background-color: @base;
}

listview {
    spacing: 10;
    padding: 8;
    border-radius: 0 0 10 10;
    border: 2 2 2 2;
    border-color: @base;
    background-color: @base;
    dynamic: false;
    columns: 2;
}

inputbar {
    children: [prompt,entry];
    background-color: inherit;
    border-radius: 5px;
    padding: 2px;
}

prompt {
    background-color: @lavender;
    padding: 10px;
    border-radius: 3px;
    margin: 25px 0px 25px 30px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    placeholder: "Type here";
    cursor: text;
    text-color: @text;
    padding: 10px;
    margin: 20px 0px 0px 10px;
}

element {
    padding: 20px;
    vertical-align: 0;
    color: @text;
}

element-text {
    background-color: inherit;
    color: inherit;
}

element selected.normal {
    background-color: @overlay0;
    color: @base;
}

element.normal.normal {
    background-color: @surface0;
    text-color:       @text;

}

element.alternate.normal {
    background-color: @surface0;
    text-color:       @text;
}

element normal active {
    background-color: @surface0;
    color: @text;
}
