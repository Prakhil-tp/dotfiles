[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/share/hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace
WorkingDirectory=%h/.local/share/hermes/hermes-agent
Environment="PATH=%h/.local/share/hermes/hermes-agent/venv/bin:%h/.local/share/hermes/hermes-agent/node_modules/.bin:%h/.local/share/asdf/shims:%h/.local/bin:%h/.local/share/cargo/bin:%h/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=%h/.local/share/hermes/hermes-agent/venv"
Environment="HERMES_HOME=%h/.local/share/hermes"
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
